VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SINGLE_ASSISTANT_RUNTIME=false
DISABLE_HMR=false

# Server-only Supabase Edge Function secrets; never expose these with VITE_ prefixes.
# OPENAI_API_KEY is configured with `supabase secrets set`, not committed here.
# OPENAI_MODEL defaults to gpt-5.6-sol.

# Optional browser smoke test. Never commit real credentials.

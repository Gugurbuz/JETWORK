+import { describe, expect, it } from 'vitest'
+import {
+  evaluateGroundedTechnicalClaims,
+  resultHasVerifiedKnowledgeEvidence,
+  shouldFailClosedGroundedAnswer,
+} from '../../../supabase/functions/_shared/groundingGuard'
+
+const verifiedMessage = (code: string, title: string) => ({
+  output: JSON.stringify({
+    securityNotice: 'UNTRUSTED_KNOWLEDGE_DATA',
+    tool: 'get_message_detail',
+    records: [{ canonicalKey: `message:${code.toLowerCase()}`, objectType: 'message', title }],
+  }),
+  sources: [{ canonicalKey: `message:${code.toLowerCase()}`, objectType: 'message', title, sourceId: 's1' }],
+  summary: { citationReady: true, resultCount: 1 },
+})
+
+describe('grounding claim coverage P0', () => {
+  it('does not count candidate-only semantic search as verified evidence', () => {
+    const candidateOnly = {
+      output: JSON.stringify({ records: [{ canonicalKey: 'message:zcrm_price_key-042' }] }),
+      sources: [], summary: { citationReady: false, resultCount: 1 },
+    }
+    expect(resultHasVerifiedKnowledgeEvidence(candidateOnly)).toBe(false)
+  })
+
+  it('blocks the reproduced one-source-enables-many-claims hallucination', () => {
+    const onlyVerified = verifiedMessage('ZB2B_CIKTI-000', 'ZB2B_CIKTI-000 — &1&2&3&4')
+    const draft = [
+      'ZB2B_CIKTI-000 — &1&2&3&4',
+      'ZB2B_CIKTI-002 — Seçilen çıktı tipi için onay akışı başlatılamadı.',
+      'ZCRM_PRICE_KEY-042 — Girilen tarih aralığı mevcut bir kayıtla çakışmaktadır.',
+      'ZCRM_PRICE_KEY-045 — Belirtilen koşul türü için fiyatlandırma anahtarı üretilemedi.',
+    ].join('\n')
+    const coverage = evaluateGroundedTechnicalClaims({
+      text: draft, plan: { knowledgeRequired: true }, sources: onlyVerified.sources, toolResults: [onlyVerified],
+    })
+    expect(coverage.unsupportedIdentifiers).toEqual(expect.arrayContaining([
+      'ZB2B_CIKTI-002', 'ZCRM_PRICE_KEY-042', 'ZCRM_PRICE_KEY-045',
+    ]))
+    expect(shouldFailClosedGroundedAnswer({ plan: { knowledgeRequired: true }, coverage })).toBe(true)
+  })
+
+  it('blocks a fabricated exact message text even when the identifier itself is verified', () => {
+    const verified = verifiedMessage('ZCRM_PRICE_KEY-045', 'ZCRM_PRICE_KEY-045 — Kalem &1: İzin verilen sözleşme adedi sınırı aşılmıştır.')
+    const coverage = evaluateGroundedTechnicalClaims({
+      text: [
+        'ZCRM_PRICE_KEY-045',
+        'Mesaj Metni: Belirtilen koşul türü için fiyatlandırma anahtarı üretilemedi.',
+      ].join('\n'),
+      plan: { knowledgeRequired: true }, sources: verified.sources, toolResults: [verified],
+    })
+    expect(coverage.unsupportedIdentifiers).toEqual([])
+    expect(coverage.messageTextMismatches).toHaveLength(1)
+    expect(coverage.messageTextMismatches[0].expected).toContain('İzin verilen sözleşme adedi sınırı aşılmıştır')
+    expect(coverage.ok).toBe(false)
+  })
+
+  it('allows a grounded exact message claim', () => {
+    const verified = verifiedMessage('ZCRM_PRICE_KEY-042', 'ZCRM_PRICE_KEY-042 — Kalem &1: Satış kanalı kuralı sağlanamadı (&2).')
+    const coverage = evaluateGroundedTechnicalClaims({
+      text: [
+        'ZCRM_PRICE_KEY-042',
+        'Mesaj Metni: Kalem &1: Satış kanalı kuralı sağlanamadı (&2).',
+      ].join('\n'),
+      plan: { knowledgeRequired: true }, sources: verified.sources, toolResults: [verified],
+    })
+    expect(coverage.ok).toBe(true)
+  })
+})
